          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="v_rdev" value="检测角色偏离 → AI 温和拉回 (如面试: As the interviewer...)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=PingFang SC;fontSize=8;" vertex="1" parent="1">
