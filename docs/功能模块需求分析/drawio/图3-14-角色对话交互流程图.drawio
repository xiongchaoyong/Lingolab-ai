        <mxCell id="e_rdev_v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=3 3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v_rdev" target="v_voice">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="336"/><mxPoint x="50" y="336"/><mxPoint x="50" y="183"/></Array></mxGeometry>
        </mxCell>
        <!-- Main flow -->
        <mxCell id="v_ds" value="Deepseek 生成角色回复 (注入角色 Prompt + 10轮上下文)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="130" y="344" width="320" height="22" as="geometry"/>
