        <mxCell id="v_open" value="AI 角色开场白 (文字 + TTS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="180" y="134" width="220" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="e_prompt_open" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v_prompt" target="v_open">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Conversation loop -->
        <mxCell id="v_voice" value="用户语音输入 (WAV ≤30s)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=9;" vertex="1" parent="1">
