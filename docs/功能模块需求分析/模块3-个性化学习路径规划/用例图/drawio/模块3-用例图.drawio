<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="模块3-个性化学习路径规划-用例图">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 系统边界 -->
        <mxCell id="boundary" value="个性化学习路径规划系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="30" width="520" height="460" as="geometry" />
        </mxCell>

        <!-- 学习者 -->
        <mxCell id="a-learner" value="学习者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 系统 -->
        <mxCell id="a-system" value="系统&#xa;(规则引擎)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 主用例 -->
        <mxCell id="uc-main" value="获取每日学习任务" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- (1) 规则引擎 -->
        <mxCell id="uc-1" value="(1) 学习路径规则计算" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- (2) 任务匹配推送 -->
        <mxCell id="uc-2" value="(2) 每日任务匹配与推送" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="260" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- (3) 任务干预 -->
        <mxCell id="uc-3" value="(3) 用户任务干预操作" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="280" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- (4) 历史记录 -->
        <mxCell id="uc-4" value="(4) 任务完成记录与回溯" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="400" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->

        <!-- 学习者 → 主用例 -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 学习者 → 任务干预 -->
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 学习者 → 历史记录 -->
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc-4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="160" />
              <mxPoint x="220" y="428" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 系统 → 规则计算 -->
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-system" target="uc-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> 主用例 → (1) -->
        <mxCell id="e-inc-1" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-main" target="uc-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> 主用例 → (2) -->
        <mxCell id="e-inc-2" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-main" target="uc-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<extend>> (3) → 主用例 -->
        <mxCell id="e-ext" value="&lt;&lt;extend&gt;&gt;&#xa;[用户操作任务时]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-3" target="uc-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
