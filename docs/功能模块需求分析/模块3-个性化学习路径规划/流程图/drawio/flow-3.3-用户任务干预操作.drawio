<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-3.3-用户任务干预操作">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="用户点击任务操作" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d0" value="操作类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 跳过分支 -->
        <mxCell id="p1a" value="检验 task_id 有效性" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p1b" value="检查该类型连续跳过天数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d1a" value="连续≥3天？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1c" value="标记 skipped&#xa;记录 skip_reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p1d" value="提示「是否不想练习&#xa;此类任务？」可关闭该类型" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 换一个分支 -->
        <mxCell id="p2a" value="检验 task_id + 剩余交换次数&#xa;(最多 3 次)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="230" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2a" value="次数已用完？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2b" value="查询同类型同难度备选&#xa;排除 7 天内已推荐" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2c" value="替换任务内容&#xa;返回新任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2d" value="返回 429&#xa;「已无更多备选」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- 调整难度分支 -->
        <mxCell id="p3a" value="解析 difficulty_feedback&#xa;(too_easy → +1 / too_hard → -1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="230" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d3a" value="已达边界？&#xa;(A1且→-1 / C2且→+1)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="320" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3b" value="更新 user_profiles.&#xa;difficulty_preference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3c" value="提示「当前已是&#xa;最低/最高难度」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- 加量分支 -->
        <mxCell id="d4a" value="3 个任务全部完成&#xa;且今日未追加过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="560" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4a" value="从短板维度匹配 1 个额外任务&#xa;写入 daily_tasks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="690" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4b" value="返回错误提示&#xa;（未完成/已追加）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="570" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="end1" value="返回操作结果给前端" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="750" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Edges: 分支路由 -->
        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- 跳到 skip -->
        <mxCell id="e-skip" value="跳过" style="exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d0" target="p1a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="145"/></Array></mxGeometry></mxCell>
        <!-- 跳到 swap -->
        <mxCell id="e-swap" value="换一个" style="exitX=0.25;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d0" target="p2a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="200"/><mxPoint x="370" y="200"/></Array></mxGeometry></mxCell>
        <!-- 跳到 difficulty -->
        <mxCell id="e-diff" value="调整难度" style="exitX=0.75;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d0" target="p3a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="200"/><mxPoint x="690" y="200"/></Array></mxGeometry></mxCell>
        <!-- 跳到 add_extra -->
        <mxCell id="e-add" value="加量" style="exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d0" target="d4a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="145"/></Array></mxGeometry></mxCell>

        <!-- Skip edges -->
        <mxCell id="es1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1a" target="p1b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1b" target="d1a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3" value="是" style="exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d1a" target="p1d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es4" value="否" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d1a" target="p1c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es5" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1d" target="end1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="660"/><mxPoint x="440" y="660"/></Array></mxGeometry></mxCell>
        <mxCell id="es6" value="" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p1c" target="end1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="513"/><mxPoint x="260" y="775"/></Array></mxGeometry></mxCell>

        <!-- Swap edges -->
        <mxCell id="ew1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p2a" target="d2a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ew2" value="否" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d2a" target="p2b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ew3" value="是" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2a" target="p2d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ew4" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p2b" target="p2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ew5" value="" style="exitX=0.5;exitY=1;entryX=1;entryY=0.5;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p2c" target="end1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="580"/><mxPoint x="550" y="580"/><mxPoint x="550" y="775"/></Array></mxGeometry></mxCell>

        <!-- Difficulty edges -->
        <mxCell id="ed1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p3a" target="d3a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed2" value="否" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d3a" target="p3b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed3" value="是" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d3a" target="p3c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed4" value="" style="exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p3b" target="end1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="453"/><mxPoint x="580" y="775"/></Array></mxGeometry></mxCell>

