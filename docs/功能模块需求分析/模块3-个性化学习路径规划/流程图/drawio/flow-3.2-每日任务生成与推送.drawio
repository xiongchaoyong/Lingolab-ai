<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-3.2-每日任务生成与推送">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="触发任务生成&#xa;(首次登录/测评完成/手动刷新)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="是否已有当日任务？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="160" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="返回已有任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="115" width="140" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="获取规则引擎输出的&#xa;权重矩阵和筛选参数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="确定有效 CEFR 等级&#xa;(cefr + difficulty_adjustment)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="任务1：匹配跟读内容&#xa;CEFR+风格+兴趣+去重7天" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="390" width="210" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p5" value="任务2：匹配对话场景&#xa;CEFR+目标场景优先+去重7天" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="210" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p6" value="任务3：匹配听力材料&#xa;CEFR+风格+去重7天" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="550" width="210" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="3个任务全部&#xa;匹配成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="640" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="放宽条件重试：&#xa;难度±1 / 去重窗口3天" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="750" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="仍然失败？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="840" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="err" value="返回 503&#xa;内容库建设中" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="845" width="140" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p7" value="写入 daily_tasks 表&#xa;状态全部 pending" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="760" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="end1" value="返回任务列表给前端" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="850" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="是→非手动" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="否/手动刷新" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p6" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="630"/><mxPoint x="460" y="630"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="是" style="exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="否" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="是" style="exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d4" target="err"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="否→重试成功" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d4" target="p7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="870"/><mxPoint x="210" y="870"/><mxPoint x="210" y="785"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p7" target="end1"><mxGeometry relative="1" as="geometry"/></mxCell>
