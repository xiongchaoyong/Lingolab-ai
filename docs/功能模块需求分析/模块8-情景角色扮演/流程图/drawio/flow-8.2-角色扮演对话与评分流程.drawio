<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-8.2-角色扮演对话与评分流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="start" value="用户选择角色" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="p1" value="展示角色说明卡&#xa;(角色目标+常见用语+建议话术)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="p2" value="注入角色设定 System Prompt&#xa;AI={ai_role} 用户={user_role}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="p3" value="复用模块6语音对话闭环&#xa;录音→Whisper→Deepseek→TTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="d1" value="用户偏离角色？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="350" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p4" value="AI 温和拉回角色&#xa;'Let us focus on...'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="355" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="d2" value="达到 5-8 轮或&#xa;AI自然结束信号？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="460" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="p5" value="继续下一轮对话" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="p6" value="收集全对话记录 → Deepseek&#xa;角色贴合度四维评分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="d3" value="对话 ≥ 3 轮？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="670" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="p7" value="提示「对话太短&#xa;无法评估」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="675" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="p8" value="加权计算综合分&#xa;40%贴合+25%礼仪+20%术语+15%应对" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="770" width="250" height="50" as="geometry"/></mxCell>
        <mxCell id="end1" value="展示评分报告 + 改进建议&#xa;（含各维度评语）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="860" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
