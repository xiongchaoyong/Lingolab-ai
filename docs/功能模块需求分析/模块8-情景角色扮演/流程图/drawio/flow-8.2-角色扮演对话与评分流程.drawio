        <mxCell id="e7" value="" style="exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="380"/><mxPoint x="560" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="否→继续" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
