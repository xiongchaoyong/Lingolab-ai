<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="模块2-英语水平智能测评-用例图">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 系统边界 -->
        <mxCell id="boundary" value="英语水平智能测评系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;verticalAlign=top;fontStyle=1;fontSize=14;verticalLabelPosition=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="30" width="520" height="520" as="geometry" />
        </mxCell>

        <!-- ===== 角色（火柴人）===== -->

        <!-- 学习者 -->
        <mxCell id="a-learner" value="学习者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 系统（外部AI API） -->
        <mxCell id="a-system" value="系统&#xa;(Whisper+Deepseek)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 运营人员 -->
        <mxCell id="a-operator" value="运营人员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- ===== 用例（椭圆）===== -->

        <!-- 主用例：参与自适应测评 -->
        <mxCell id="uc-main" value="参与自适应测评" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- (1) 自适应题目推送 -->
        <mxCell id="uc-1" value="(1) 自适应题目推送引擎" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="170" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- (2) 客观题作答与判分 -->
        <mxCell id="uc-2" value="(2) 客观题作答与判分" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- (3) 口语录音与AI评分 -->
        <mxCell id="uc-3" value="(3) 口语录音与AI评分" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- (4) 进度保存与断点恢复 -->
        <mxCell id="uc-4" value="(4) 进度保存与断点恢复" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="240" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- (5) 测评报告生成与展示 -->
        <mxCell id="uc-5" value="(5) 测评报告生成与展示" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="440" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- (6) 题库管理（系统边界外） -->
        <mxCell id="uc-6" value="(6) 测评题库管理" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="600" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- ===== 关联关系（边）===== -->

        <!-- 学习者 → 参与自适应测评 -->
        <mxCell id="e-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 学习者 → 查看测评报告 -->
        <mxCell id="e-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc-5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="150" />
              <mxPoint x="220" y="468" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 运营人员 → 题库管理 -->
        <mxCell id="e-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a-operator" target="uc-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 系统 → 口语录音与AI评分 -->
        <mxCell id="e-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a-system" target="uc-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> 主用例 → (1) 自适应题目推送 -->
        <mxCell id="e-inc-1" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-main" target="uc-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> 主用例 → (2) 客观题作答判分 -->
        <mxCell id="e-inc-2" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-main" target="uc-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> 主用例 → (3) 口语录音AI评分 -->
        <mxCell id="e-inc-3" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-main" target="uc-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<extend>> (4)进度恢复 → 主用例（条件扩展） -->
        <mxCell id="e-ext-4" value="&lt;&lt;extend&gt;&gt;&#xa;[测评中断时]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;fontColor=#888888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc-4" target="uc-main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
