<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-2.3-口语题录音与AI评分">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="前端上传口语录音" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 校验音频 -->
        <mxCell id="p1" value="校验音频格式/大小/时长" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 音频有效性 -->
        <mxCell id="d1" value="音频有效性检查&#xa;（静音/时长&lt;5s/文件过大）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="190" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- 重录判断 -->
        <mxCell id="d2" value="是否已重录过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="310" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 返回重录 -->
        <mxCell id="p2" value="返回 422&#xa;提示重录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- 标记0分 -->
        <mxCell id="p3" value="标记 0 分&#xa;不计入自适应" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- 调用Whisper -->
        <mxCell id="p4" value="调用 Whisper API&#xa;语音转写" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="310" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Whisper成功 -->
        <mxCell id="d3" value="转写是否成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="410" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 重试Whisper -->
        <mxCell id="d4" value="已重试 1 次？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Whisper错误 -->
        <mxCell id="p5" value="返回 500&#xa;语音识别服务不可用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="430" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 构造Prompt -->
        <mxCell id="p6" value="构造 Deepseek 评分 Prompt&#xa;（话题 + 转写文本）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="520" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 调用Deepseek -->
        <mxCell id="p7" value="调用 Deepseek API&#xa;四维评分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="600" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Deepseek成功 -->
        <mxCell id="d5" value="评分是否成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="690" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 解析评分 -->
        <mxCell id="p8" value="解析四维分数&#xa;content/grammar/vocab/coherence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="690" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- 标记N/A -->
