<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-2.4-测评进度保存与断点恢复">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="前端加载测评页面&#xa;调用 check API" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 查询会话 -->
        <mxCell id="p1" value="查询用户未完成会话&#xa;(status = in_progress)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 有会话 -->
        <mxCell id="d1" value="是否有未完成&#xa;测评会话？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="210" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- 开始新测评 -->
        <mxCell id="p2" value="创建新 assessment_session&#xa;开始新测评" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="215" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 检查过期 -->
        <mxCell id="d2" value="updated_at&#xa;距今 > 30 分钟？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- 过期处理 -->
        <mxCell id="p3" value="标记会话 expired&#xa;提示用户重新开始" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 恢复信息 -->
        <mxCell id="p4" value="返回会话信息&#xa;(session_id + 已答题数)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="345" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 用户选择 -->
        <mxCell id="d3" value="用户是否选择&#xa;恢复测评？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="450" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- 调用resume -->
        <mxCell id="p5" value="调用 POST resume API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="350" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- 口语评分检查 -->
        <mxCell id="d4" value="有口语题&#xa;status=scoring？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="440" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- 等待评分 -->
        <mxCell id="p6" value="等待评分完成&#xa;（超时 5s 则标记 0 分）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="560" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 返回题目 -->
        <mxCell id="p7" value="恢复当前难度和进度&#xa;返回下一题数据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="580" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 继续答题 -->
        <mxCell id="p8" value="用户继续答题&#xa;每题后自动保存进度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="680" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end1" value="测评完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="780" width="120" height="45" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->

        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d1 → p2 (无会话) -->
        <mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d1 → d2 (有会话) -->
        <mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="250" />
              <mxPoint x="165" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- d2 → p3 (过期) -->
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d2 → p4 (未过期) -->
        <mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="d2" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- p4 → d3 -->
        <mxCell id="e7" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p4" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d3 → p2 (否-重新开始) -->
        <mxCell id="e8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="d3" target="p2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="490" />
              <mxPoint x="540" y="243" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- d3 → p5 (是-恢复) -->
        <mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="d3" target="p5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="490" />
              <mxPoint x="540" y="373" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- p5 → d4 -->
        <mxCell id="e10" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p5" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d4 → p6 (有scoring) -->
        <mxCell id="e11" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d4" target="p6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d4 → p7 (无scoring) -->
        <mxCell id="e12" value="无" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="d4" target="p7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="480" />
              <mxPoint x="550" y="608" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- p6 → p7 (等待完成) -->
        <mxCell id="e13" value="等待完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="p6" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- p7 → p8 -->
        <mxCell id="e14" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p7" target="p8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- p8 → end1 -->
        <mxCell id="e15" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p8" target="end1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- p2 → p8 (新测评也到继续答题) -->
        <mxCell id="e16" value="新测评" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;endArrow=block;" edge="1" parent="1" source="p2" target="p8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="243" />
              <mxPoint x="580" y="708" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
