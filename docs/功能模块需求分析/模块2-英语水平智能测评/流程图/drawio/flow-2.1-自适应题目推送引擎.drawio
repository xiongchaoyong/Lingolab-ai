        <!-- d3 → p5 (全对) -->
        <mxCell id="e10" value="全对" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d3" target="p5">
