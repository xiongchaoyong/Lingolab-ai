          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- p2 → d2 -->
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;" edge="1" parent="1" source="p2" target="d2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="328" />
              <mxPoint x="320" y="435" />
