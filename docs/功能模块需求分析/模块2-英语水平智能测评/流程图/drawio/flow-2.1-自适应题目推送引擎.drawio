<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-2.1-自适应题目推送引擎">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="前端请求下一题" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 是否首题 -->
        <mxCell id="d1" value="是否首题请求？&#xa;(index == 0)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- 读取自评等级 -->
        <mxCell id="p1" value="读取 user_profiles.level_self&#xa;映射 CEFR 起点难度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 创建会话 -->
        <mxCell id="p2" value="创建 assessment_session&#xa;记录初始难度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 调整难度 -->
        <mxCell id="p3" value="解析 last_answer_result&#xa;答对→难度+0.5 答错→难度-0.5&#xa;口语0分→难度不变" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="210" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- 保存答题记录 -->
        <mxCell id="p4" value="保存已答题记录&#xa;递增 current_question_index" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- 已答10题 -->
        <mxCell id="d2" value="已答满 10 题？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 全对全错判断 -->
        <mxCell id="d3" value="全部答对&#xa;或全部答错？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="510" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- 全对追加 -->
        <mxCell id="p5" value="追加 C2 确认题" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="630" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- 全错追加 -->
        <mxCell id="p6" value="追加 A1 兜底题" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="630" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- 确定维度 -->
        <mxCell id="p7" value="按题序模板确定&#xa;下一题维度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- 查题库 -->
        <mxCell id="p8" value="按难度 + 维度查题库" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- 有匹配题 -->
        <mxCell id="d4" value="有匹配题目？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="570" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 降级查找 -->
        <mxCell id="p9" value="降级查找&#xa;（C2→C1→...→A1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="170" height="55" as="geometry" />
        </mxCell>

        <!-- 返回题目 -->
        <mxCell id="p10" value="返回题目数据 + 更新会话状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="690" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 完成 -->
        <mxCell id="end1" value="返回 assessment_complete: true&#xa;前端跳转报告页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="780" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 错误 -->
        <mxCell id="err" value="返回 500&#xa;题库数据不足" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="690" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->

        <!-- start → d1 -->
        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d1 → p1 (Yes-首题) -->
        <mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d1" target="p1">
          <mxGeometry relative="1" as="geometry" />
