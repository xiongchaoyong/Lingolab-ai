        <!-- p4 → d2 -->
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;" edge="1" parent="1" source="p4" target="d2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="328" />
              <mxPoint x="580" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- d2 → p7 (No-未满10题) -->
        <mxCell id="e8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d2" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- d2 → d3 (Yes-满10题) -->
        <mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=10;endArrow=block;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
