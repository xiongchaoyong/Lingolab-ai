<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-4.2-语音录制与校验">
    <mxGraphModel>
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="start" value="用户点击录音按钮" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="前端请求麦克风权限&#xa;开始录音采集 (≥16kHz)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="权限是否授权？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="提示「请在浏览器设置&#xa;中允许麦克风权限」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="195" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="用户跟读录音&#xa;（点击停止/自动截断）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="290" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="前端上传音频文件&#xa;(multipart/form-data)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="370" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="音频有效性校验&#xa;(静音/时长/大小)？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="460" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="是否已重录过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="580" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="返回 422 + 提示重录&#xa;retry_flag = true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="690" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="标记 0 分&#xa;不计入评测次数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="690" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="存储音频文件&#xa;返回 audio_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="475" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end1" value="触发评分引擎" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="570" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="是" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="否" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="无效" style="exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="有效" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="否" style="exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d3" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="是" style="exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d3" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p7" target="end1"><mxGeometry relative="1" as="geometry"/></mxCell>
