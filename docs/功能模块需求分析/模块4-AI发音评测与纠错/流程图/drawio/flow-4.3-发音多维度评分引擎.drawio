        <mxCell id="e13" value="失败" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d4" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="成功" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d4" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
