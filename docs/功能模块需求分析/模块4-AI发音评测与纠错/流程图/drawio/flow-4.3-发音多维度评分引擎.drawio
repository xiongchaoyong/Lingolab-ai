<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-4.3-发音多维度评分引擎">
    <mxGraphModel>
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="start" value="接收 audio_id + content_id" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="获取标准内容数据&#xa;(标准音频 + 音素序列 + IPA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="调用 Whisper API&#xa;音素级转写 + 时间戳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Whisper 调用成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="270" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="已重试 1 次？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="275" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="返回 504&#xa;评分服务繁忙" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="解析音素序列 + 置信度&#xa;对比转写文本 vs 标准文本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="380" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="转写与原文&#xa;匹配？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="470" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="标记 warning&#xa;「可能读错内容」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="475" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="DTW 音素对齐&#xa;用户音素 ↔ 标准音素" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="570" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="音素对齐成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="660" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="降级为整体评分&#xa;仅基于转写文本评估" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="665" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="逐维计算分数&#xa;音素/重音/连读/语调/节奏" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="760" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="按模式加权求综合分&#xa;word: 50-25-25 | sentence: 40-15-15-15-15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="840" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="end1" value="返回评分结果 + 颜色标注" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="930" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;html=1;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="失败" style="exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="否→重试" style="exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;fontSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="d2" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="305"/><mxPoint x="580" y="205"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="是→放弃" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=10;html=1;" edge="1" parent="1" source="d2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
