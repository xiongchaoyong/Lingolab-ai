  <diagram name="flow-6.2-语音对话闭环引擎">
    <mxGraphModel>
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="start" value="用户点击录音按钮" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="p1" value="前端采集音频 → 上传&#xa;(multipart/form-data, ≤3MB)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="d1" value="音频有效性校验&#xa;(静音/时长)？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="160" height="65" as="geometry"/></mxCell>
        <mxCell id="d2" value="静音且超5s？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="195" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="p2" value="AI主动提示&#xa;'Could you repeat?'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="p3" value="提示重录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="200" width="100" height="45" as="geometry"/></mxCell>
        <mxCell id="p4" value="Whisper API 转写&#xa;获取 transcript + confidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="d3" value="转写成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="390" width="140" height="60" as="geometry"/></mxCell>
