        <mxCell id="p7" value="注入下一轮 Deepseek Prompt&#xa;(vocab/speed/len/correction)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="720" width="220" height="50" as="geometry" />
