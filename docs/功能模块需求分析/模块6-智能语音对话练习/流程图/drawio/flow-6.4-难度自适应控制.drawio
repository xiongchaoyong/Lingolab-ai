        </mxCell>

        <mxCell id="p5" value="effective_difficulty += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="180" height="45" as="geometry" />
