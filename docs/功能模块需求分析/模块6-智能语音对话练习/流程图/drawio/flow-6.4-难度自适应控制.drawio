<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="flow-6.4-难度自适应控制">
    <mxGraphModel>
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="start" value="每轮对话完成→&#xa;获取用户错误率" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="读取当前 effective_difficulty&#xa;查表获取四维参数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="统计近 3 轮平均错误率" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="avg_error &gt; 30%？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="290" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="当前已是 A1？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="140" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="effective_difficulty -= 1&#xa;更新会话参数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="保持 A1 不变" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="130" height="45" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="近 5 轮 avg_error&#xa;&lt; 10%？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="400" width="150" height="65" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="当前已是 C2？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
