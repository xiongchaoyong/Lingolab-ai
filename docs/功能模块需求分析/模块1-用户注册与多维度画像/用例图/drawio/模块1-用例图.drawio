<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="模块1-用户注册与多维度画像-用例图">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 系统边界 -->
        <mxCell id="boundary" value="用户注册与多维度画像系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="30" width="520" height="530" as="geometry" />
        </mxCell>

        <!-- 学习者 -->
        <mxCell id="a-learner" value="学习者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 系统 -->
        <mxCell id="a-system" value="系统" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- 主用例：用户注册 -->
        <mxCell id="uc1" value="(1) 用户注册&#xa;用户名+密码注册+采集画像" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- (2) 登录与JWT鉴权 -->
        <mxCell id="uc2" value="(2) 登录与JWT鉴权&#xa;Token 24h有效期" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="200" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- (3) 年龄自动归类 -->
        <mxCell id="uc3" value="(3) 年龄自动归类&#xa;5个年龄段映射" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- (4) 用户自评等级 -->
        <mxCell id="uc4" value="(4) 用户自评等级&#xa;临时等级用于初始推荐" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- (5) 用户画像生成 -->
        <mxCell id="uc5" value="(5) 用户画像生成与管理&#xa;整合注册+自评+测评结果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- (6) 测评强制引导 -->
        <mxCell id="uc6" value="(6) 测评强制引导&#xa;锁定功能至测评完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- (7) 测评进度追踪 -->
        <mxCell id="uc7" value="(7) 测评进度追踪&#xa;中断保存+断点恢复" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="460" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->

        <!-- 学习者 → (1) -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 学习者 → (2) -->
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-learner" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 系统 → (3) -->
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-system" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 系统 → (5) -->
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-system" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 系统 → (7) -->
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="a-system" target="uc7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> (1)→(3) 年龄归类 -->
        <mxCell id="ei1" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc1" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> (1)→(4) 自评等级 -->
        <mxCell id="ei2" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc1" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<include>> (1)→(5) 画像生成 -->
        <mxCell id="ei3" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=1;exitY=0.7;entryX=0;entryY=0.3;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc1" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<extend>> (1)→(6) 测评强制引导（注册后触发） -->
        <mxCell id="ee1" value="&lt;&lt;extend&gt;&gt;&#xa;[注册完成后]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc1" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- <<extend>> (2)→(6) 测评强制引导（登录后触发） -->
        <mxCell id="ee2" value="&lt;&lt;extend&gt;&gt;&#xa;[未完成测评时登录]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc2" target="uc6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="290" />
              <mxPoint x="350" y="290" />
              <mxPoint x="350" y="373" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- <<include>> (6)→(7) 进度追踪 -->
        <mxCell id="ei4" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#888;fontSize=10;endArrow=open;" edge="1" parent="1" source="uc6" target="uc7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
