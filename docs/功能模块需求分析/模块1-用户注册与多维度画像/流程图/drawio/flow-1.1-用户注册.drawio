<mxfile host="Claude Code" modified="2026-05-29T00:00:00.000Z" agent="drawio-skill" version="21.0.0">
  <diagram name="flow-1.1-用户注册" id="flow-1-1">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="225" y="20" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- 接收注册请求 -->
        <mxCell id="step1" value="接收注册请求&#xa;(username/password/age/&#xa;learning_goal/interests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="100" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="edge-start-step1" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 字段格式校验 -->
        <mxCell id="validate" value="字段格式校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="205" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-step1-validate" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="step1" target="validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 校验失败分支 -->
        <mxCell id="error1" value="返回 422&#xa;字段校验错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-validate-error1" value="不通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="validate" target="error1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 查询用户名唯一性 -->
        <mxCell id="checkUnique" value="查询用户名唯一性" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="305" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-validate-checkUnique" value="通过" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="validate" target="checkUnique">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 用户名已存在 -->
        <mxCell id="error2" value="返回 409&#xa;用户名已被注册" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkUnique-error2" value="已存在" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="checkUnique" target="error2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- bcrypt加密 -->
        <mxCell id="bcrypt" value="bcrypt 加密密码&#xa;(rounds=12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="405" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkUnique-bcrypt" value="不存在" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="checkUnique" target="bcrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 年龄自动归类 -->
        <mxCell id="ageClassify" value="年龄自动归类&#xa;(子功能3 → age_group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="495" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-bcrypt-ageClassify" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="bcrypt" target="ageClassify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 创建数据库记录 -->
        <mxCell id="createDB" value="事务创建 user +&#xa;user_profile 记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="205" y="580" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-ageClassify-createDB" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="ageClassify" target="createDB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 生成JWT -->
        <mxCell id="genJWT" value="生成 JWT Token&#xa;(24h 有效期)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="670" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-createDB-genJWT" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="createDB" target="genJWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 返回成功 -->
        <mxCell id="success" value="返回 201&#xa;用户信息 + JWT Token&#xa;assessment_completed=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="755" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="edge-genJWT-success" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="genJWT" target="success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end" value="结束（触发子功能6&#xa;强制跳转测评）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="205" y="855" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-success-end" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="success" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
