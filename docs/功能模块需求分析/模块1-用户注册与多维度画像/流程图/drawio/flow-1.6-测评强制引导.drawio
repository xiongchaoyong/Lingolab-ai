<mxfile host="Claude Code" modified="2026-05-29T00:00:00.000Z" agent="drawio-skill" version="21.0.0">
  <diagram name="flow-1.6-测评强制引导" id="flow-1-6">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="用户登录成功&#xa;或注册成功" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- 获取画像 -->
        <mxCell id="getProfile" value="获取 user_profiles&#xa;assessment_completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-start-getProfile" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="getProfile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 判断1: 已完成测评? -->
        <mxCell id="checkCompleted" value="assessment_&#xa;completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="215" y="205" width="120" height="65" as="geometry" />
        </mxCell>
        <mxCell id="edge-getProfile-checkCompleted" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="getProfile" target="checkCompleted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- true: 放行 -->
        <mxCell id="allow" value="正常放行&#xa;进入首页/目标页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="210" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkCompleted-allow" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="checkCompleted" target="allow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 结束-放行 -->
        <mxCell id="endAllow" value="用户正常使用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="300" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-allow-endAllow" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="allow" target="endAllow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- false: 强制引导 -->
        <mxCell id="forceGuide" value="need_assessment = true&#xa;前端存储标志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="315" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkCompleted-forceGuide" value="false" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=10;fontColor=#d6b656;" edge="1" parent="1" source="checkCompleted" target="forceGuide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 路由守卫 -->
        <mxCell id="routerGuard" value="前端路由守卫激活&#xa;监听每次路由跳转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="410" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-forceGuide-routerGuard" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="forceGuide" target="routerGuard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 用户访问页面 -->
        <mxCell id="userVisit" value="用户访问某页面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="505" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-routerGuard-userVisit" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="routerGuard" target="userVisit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 判断目标路由 -->
        <mxCell id="checkRoute" value="目标路由在&#xa;白名单?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="215" y="585" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-userVisit-checkRoute" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="userVisit" target="checkRoute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 白名单放行 -->
        <mxCell id="whitelist" value="放行&#xa;（白名单路由）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkRoute-whitelist" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="checkRoute" target="whitelist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 重定向 -->
        <mxCell id="redirect" value="重定向到测评页&#xa;/assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="690" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge-checkRoute-redirect" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="checkRoute" target="redirect">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="680" />
              <mxPoint x="475" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 进入测评 -->
        <mxCell id="enterAssessment" value="进入测评页&#xa;（模块2）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="780" width="105" height="45" as="geometry" />
        </mxCell>
        <mxCell id="edge-redirect-enterAssessment" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="redirect" target="enterAssessment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 测评完成后循环 -->
        <mxCell id="assessmentDone" value="测评完成&#xa;更新 assessment_&#xa;completed = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="870" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-enterAssessment-assessmentDone" style="html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="enterAssessment" target="assessmentDone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
