        <mxCell id="h4l" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="60"/><mxPoint x="600" y="650"/></mxGeometry></mxCell>

        <mxCell id="h5" value="TTSClient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="20" width="90" height="40"/></mxCell>
        <mxCell id="h5l" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="60"/><mxPoint x="755" y="650"/></mxGeometry></mxCell>

        <!-- Initialization -->
        <mxCell id="m1" value="1. 选择场景 (自我介绍/问路/购物/餐厅)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="90"/><mxPoint x="260" y="90"/></mxGeometry></mxCell>

        <mxCell id="m2" value="2. 创建会话 + 加载场景 Prompt" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=SimSun;fontSize=8;" vertex="1" parent="1"><mxGeometry x="265" y="110" width="200" height="15"/></mxCell>

        <mxCell id="m3" value="3. AI 开场白 → TTS 合成语音" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="145"/><mxPoint x="600" y="145"/></mxGeometry></mxCell>
        <mxCell id="m3r" value="TTS合成→前端播放" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="175"/><mxPoint x="85" y="175"/></mxGeometry></mxCell>

