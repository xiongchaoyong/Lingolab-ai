        <mxCell id="m6" value="6. chat(messages+难度参数) → AI回复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="315"/><mxPoint x="600" y="315"/></mxGeometry></mxCell>

        <mxCell id="diff" value="A1-A2:基础词库/慢语速/每轮提示&#xa;B1:中阶词库/正常语速/3轮提示&#xa;B2+:高阶词库/偏快语速/仅明显错误" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=8;align=left;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="385" y="340" width="230" height="52"/></mxCell>

        <mxCell id="m7" value="7. synthesize(AI回复) → MP3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="420"/><mxPoint x="755" y="420"/></mxGeometry></mxCell>

