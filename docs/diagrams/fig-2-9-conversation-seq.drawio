        <mxCell id="m9" value="9. UPDATE conversation_sessions (overall_score)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="590"/><mxPoint x="260" y="640"/></mxGeometry></mxCell>

