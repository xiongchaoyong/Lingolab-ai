        <mxCell id="loop" value="对话轮次 (5-8 轮)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;fontFamily=SimSun;fontSize=9;fontColor=#666666;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="15" y="200" width="900" height="280"/></mxCell>

