<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="用户服务模块类图">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- API Layer -->
        <mxCell id="api-group" value="API 路由层 (app/api/)" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="auth-router" value="AuthRouter&#xa;+ POST /register&#xa;+ POST /login&#xa;+ POST /refresh" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="api-group">
          <mxGeometry x="20" y="35" width="180" height="80" as="geometry" />
        </mxCell>
