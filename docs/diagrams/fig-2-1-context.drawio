        <!-- Edge: System → 文件系统 -->
        <mxCell id="e8" value="文件读写&#xa;音频存储/过期清理" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-boundary" target="filesys">
