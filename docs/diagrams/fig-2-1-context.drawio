        <!-- Edge: System → Whisper -->
        <mxCell id="e4" value="HTTPS&#xa;音频文件 → 转写文本+音素时间戳" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=SimSun;fontSize=8;endArrow=classic;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-boundary" target="whisper">
