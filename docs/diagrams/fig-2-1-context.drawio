        <mxCell id="mysql" value="MySQL 8.0" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;fontStyle=1;size=15;" vertex="1" parent="1">
