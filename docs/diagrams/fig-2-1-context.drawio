          <mxGeometry x="30" y="440" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- Whisper API -->
        <mxCell id="whisper" value="Whisper API&#xa;语音转写 + 音素对齐" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;fontStyle=1;" vertex="1" parent="1">
