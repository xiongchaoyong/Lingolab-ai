        <mxCell id="filesys" value="文件系统&#xa;uploads/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="590" width="140" height="55" as="geometry" />
