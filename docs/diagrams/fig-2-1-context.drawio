<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="系统上下文图">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 系统边界虚线框 -->
        <mxCell id="sys-boundary" value="Lingolab-ai 英语口语训练平台" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 8;fontFamily=SimSun;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="440" height="450" as="geometry" />
        </mxCell>

        <!-- 系统内部核心组件 -->
        <mxCell id="sys-inner" value="Vue 3 前端&#xa;FastAPI 后端&#xa;SQLAlchemy ORM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- 学习者 -->
        <mxCell id="learner" value="学习者&#xa;Learner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=SimSun;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="270" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- 教师 -->
