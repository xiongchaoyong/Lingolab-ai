        <mxCell id="descUser" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eef7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" value="&lt;b&gt;用户端子系统&lt;/b&gt; — 面向学习者的核心功能，提供从注册、测评、学习到激励的完整闭环体验。涵盖发音训练、AI 对话、个性化推荐、进度追踪等全部学习场景，是所有 C 端用户的主要交互入口。" vertex="1">
          <mxGeometry height="80" width="340" x="60" y="660" as="geometry" />
        </mxCell>
        <mxCell id="descAdmin" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" value="&lt;b&gt;管理端子系统&lt;/b&gt; — 面向教师和运营人员的后台功能。教师端支持班级管理、学生学情查看、作业布置与录音点评；运营端提供用户管理、内容审核、活动配置及数据仪表盘等后台管理能力。" vertex="1">
          <mxGeometry height="80" width="340" x="460" y="660" as="geometry" />
        </mxCell>
        <mxCell id="descSupport" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf4e8;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" value="&lt;b&gt;智能客服子系统&lt;/b&gt; — 基于 AI 的自动答疑系统，支持语音和文字双模态交互。覆盖常见问题自动应答，复杂问题自动分类并转接人工处理，降低运营人力成本。" vertex="1">
