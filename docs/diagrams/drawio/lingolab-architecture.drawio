<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw.io" version="26.0.0">
  <diagram name="Lingolab-ai Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Tier 1: Client ===== -->
        <mxCell id="client-tier" value="客户端层" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="浏览器&#xa;Vue 3 SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="client-tier">
          <mxGeometry x="310" y="30" width="220" height="52" as="geometry" />
        </mxCell>

        <!-- ===== Tier 2: Frontend ===== -->
        <mxCell id="frontend-tier" value="前端应用层 (Vue 3 + Vite)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
