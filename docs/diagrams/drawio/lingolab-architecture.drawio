        <mxCell id="router" value="Vue Router&#xa;路由管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="frontend-tier">
